{
  "manifest_version": 3,
  "name": "PvBuddy Chatbot2",
  "version": "1.0",
  "description": "A campus support chatbot for PVAMU.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "PvBuddy.png"
    }
